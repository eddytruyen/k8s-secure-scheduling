# Experiment 14 (many tenants), one step. TEMPLATE: the driver
# (run-concurrent-multitenancy-many-tenants-evaluation.sh, gen_cl2) fills in
#   __CREATE_PHASES__  one phase per tenant and workload (G tenants x workloads a, b), tuningSet UniformQPS
#   __DELETE_PHASES__  the same phases with 0 replicas
#   __TOTAL__          G x S = 2000 pods
# and writes the result next to copies of workload-a.yaml / workload-b.yaml. The SAME config is used by every arm
# (klastos, kyverno, gkinj): the workload is identical, only the policy engine differs.
# Shape and settings are those of experiments 8 and 9 (../multi-tenancy-antiaffinity-and-affinity/
# config-klastos-concurrent.yaml): one phase per class and workload, all phases of the step in parallel on the
# shared UniformQPS budget (so tenants arrive interleaved), WaitForRunningPods timeout 5m. Throughput is one
# combined number over all tenants; per-tenant latency comes from e2e-latency.json (it records each pod's namespace).

{{$defaultQps := DefaultParam .CL2_DEFAULT_QPS  500}}
{{$defaultBurst := DefaultParam .CL2_DEFAULT_BURST 1000}}
{{$uniformQps := DefaultParam .CL2_UNIFORM_QPS 500}}
{{$uniformQpsGlobal := DefaultParam .CL2_UNIFORM_QPS_GLOBAL false}}
{{$uniformBurst := DefaultParam .CL2_UNIFORM_BURST 30}}

{{$SCHEDULER_THROUGHPUT_THRESHOLD := DefaultParam .CL2_SCHEDULER_THROUGHPUT_THRESHOLD 30}}
{{$enableViolations := DefaultParam .CL2_ENABLE_VIOLATIONS_FOR_SCHEDULING_THROUGHPUT true}}

name: multitenancy-many-tenants-concurrent-scheduler-throughput
namespace:
  enableExistingNamespaces: true
tuningSets:
- name: default
  globalQPSLoad:
    qps: {{$defaultQps}}
    burst: {{$defaultBurst}}
- name: UniformQPS
{{if $uniformQpsGlobal}}
  globalQPSLoad:
    qps: {{$uniformQps}}
    burst: {{$uniformBurst}}
{{else}}
  qpsLoad:
    qps: {{$uniformQps}}
{{end}}
steps:
- name: Creating scheduler throughput measurements
  measurements:
  - Identifier: DirectSchedulingThroughput
    Method: SchedulingThroughput
    Params:
      action: start
      labelSelector: group = direct-scheduler-throughput
      measurementInterval: 1s
  - Identifier: APIAvailability
    Method: APIAvailability
    Params:
      action: start
      labelSelector: group = direct-scheduler-throughput
      pollFrequency: 1s
  - Identifier: APIResponsivenessPrometheus
    Method: APIResponsivenessPrometheus
    Params:
      action: start
      labelSelector: group = direct-scheduler-throughput
  - Identifier: SchedulingMetrics
    Method: SchedulingMetrics
    Params:
      action: start
      labelSelector: group = direct-scheduler-throughput
      measurementInterval: 1s
  - Identifier: SchedulingThroughputPrometheus
    Method: SchedulingThroughputPrometheus
    Params:
      action: start
      labelSelector: group = direct-scheduler-throughput
      measurementInterval: 1s

- name: create the pods of every tenant (all tenants concurrently alive)
  phases:
__CREATE_PHASES__

- name: Waiting for the pods to be running
  measurements:
  - Identifier: WaitForDirectSchedulerThroughputPods
    Method: WaitForRunningPods
    Params:
      action: gather
      timeout: 5m
      desiredPodCount: __TOTAL__
      labelSelector: group = direct-scheduler-throughput

- name: Collecting scheduler throughput measurements
  measurements:
  - Identifier: APIAvailability
    Method: APIAvailability
    Params:
      action: gather
  - Identifier: APIResponsivenessPrometheus
    Method: APIResponsivenessPrometheus
    Params:
      action: gather
  - Identifier: SchedulingMetrics
    Method: SchedulingMetrics
    Params:
      action: gather
  - Identifier: DirectSchedulingThroughput
    Method: SchedulingThroughput
    Params:
      action: gather
      enableViolations: {{$enableViolations}}
      threshold: {{$SCHEDULER_THROUGHPUT_THRESHOLD}}
  - Identifier: SchedulingThroughputPrometheus
    Method: SchedulingThroughputPrometheus
    Params:
      action: gather

- name: Delete the pods of every tenant
  phases:
__DELETE_PHASES__
